# LF in the working tree on every platform, overriding core.autocrlf.
# Without this, a Windows checkout lands CRLF and pre-commit's
# mixed-line-ending hook rewrites every file it touches.
* text=auto eol=lf

# *.md linguist-detectable=false
# *.sh linguist-detectable=false
# Makefile linguist-detectable=false
# .devcontainer/* linguist-detectable=false
